
# 1. Define Variables
TIMESTAMP=$(date +%F_%H-%M-%S)
1stprojectimpl ="mongodb_backup_$TIMESTAMP"
S3_BUCKET=" 1stprojectimpl "

# 2. Run mongodump (Creates a 'dump' folder)
mongodump --out ./$1stprojectimpl

# 3. Zip the backup folder
tar -cvzf $1stprojectimpl .tar.gz ./$1stprojectimpl

# 4. Upload to S3
aws s3 cp $1stprojectimpl .tar.gz s3://$1stprojectimpl /

# 5. Cleanup local files (to save space)
rm -rf ./$1stprojectimpl
rm $1stprojectimpl E.tar.gz

echo "Backup $BACKUP_NAME uploaded successfully!"


